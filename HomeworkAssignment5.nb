Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9813954347794647`*^9, 3.9813954347827597`*^9}, 
   3.98141045653787*^9},ExpressionUUID->"68f827b6-f7b9-4c4b-b967-\
ab540e585454"],

Cell["\<\
Stability: These catalytic modules are designed to reach a stable steady \
state as since the inputs are held constant, and there are annihilation \
reactions present to prevent explosive dynamics.
Hidden Species: There are no \[OpenCurlyDoubleQuote]hidden\
\[CloseCurlyDoubleQuote] species going to infinity here because all species \
have degradation paths (like Y\[RightArrow]\[EmptySet]) or consuming \
reactions (like 2Z\[RightArrow]Z).
Convergence Time: The time to reach steady state is determined by the slowest \
rate constant. \
\>", "Text",
 CellChangeTimes->{
  3.981424545737451*^9, {3.981424627474986*^9, 3.9814246537460213`*^9}, {
   3.981424698503292*^9, 3.981424710412477*^9}, 
   3.981424770513826*^9},ExpressionUUID->"a9d9e95f-318a-4401-9296-\
f62d65e46165"],

