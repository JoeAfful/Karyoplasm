Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    TemplateBox[{"\[ThinSpace]", "\" \"", 
      RowBox[{"A", "+", "B"}], 
      OverscriptBox["\[LongRightArrow]", "1"], 
      RowBox[{"A", "+", "B", "+", "Y"}]},
     "RowWithSeparators"],
    $CellContext`rxn[$CellContext`A + $CellContext`B, $CellContext`A + \
$CellContext`B + $CellContext`Y, 1]], ",", 
