Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Inputs", ":", "a"}], "=", "9"}], ",", 
    RowBox[{"b", "=", 
     RowBox[{
      RowBox[{"9.", " ", "Expected", " ", "output", " ", "Z"}], "=", 
      RowBox[{
       RowBox[{"Sqrt", "[", "36", "]"}], "=", "6"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"inputs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"conc", "[", 
        RowBox[{"A", ",", "9"}], "]"}], ",", 
       RowBox[{"conc", "[", 
        RowBox[{"B", ",", "9"}], "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tmax", "=", "20"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Run", " ", "simulation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"SimulateRxnsys", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"systematicCRN", ",", "inputs"}], "]"}], ",", "tmax"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Y", "[", "t", "]"}], ",", 
         RowBox[{"Z", "[", "t", "]"}]}], "}"}], "/.", " ", "sol"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Intermediate Y (A*B)\>\"", 
        ",", "\"\<Final Output Z (Sqrt[Y])\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time\>\"", ",", "\"\<Concentration\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Geometric Mean\>\""}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
