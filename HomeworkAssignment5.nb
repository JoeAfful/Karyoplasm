Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Multiplication", " ", 
     RowBox[{"Module", ":", "Y"}]}], "=", 
    RowBox[{"A", "*", "B"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Rate", " ", "constants", " ", "are", " ", "set", " ", "to", " ", "1", " ",
      "so", " ", "that", " ", "at", " ", "steady", " ", 
     RowBox[{"state", "[", "Y", "]"}]}], "=", 
    RowBox[{
     RowBox[{"[", "A", "]"}], "[", "B", "]"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"multModule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rxn", "[", 
        RowBox[{
         RowBox[{"A", "+", "B"}], ",", 
         RowBox[{"A", "+", "B", "+", "Y"}], ",", "1"}], "]"}], ",", 
       RowBox[{"rxn", "[", 
        RowBox[{"Y", ",", "0", ",", "1"}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Square", " ", "Root", " ", 
      RowBox[{"Module", ":", "Z"}]}], "=", 
     RowBox[{"Sqrt", "[", "Y", "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"At", " ", "steady", " ", "state"}], ",", 
     RowBox[{
      RowBox[{"1", "*", 
       RowBox[{"[", "Y", "]"}]}], "=", 
      RowBox[{"1", "*", 
       RowBox[{
        RowBox[{"[", "Z", "]"}], "^", "2"}]}]}], ",", 
     RowBox[{
      RowBox[{"so", "[", "Z", "]"}], "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"[", "Y", "]"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sqrtModule", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rxn", "[", 
        RowBox[{"Y", ",", 
         RowBox[{"Y", "+", "Z"}], ",", "1"}], "]"}], ",", 
       RowBox[{"rxn", "[", 
        RowBox[{
         RowBox[{"2", " ", "Z"}], ",", "Z", ",", "1"}], "]"}]}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "into", " ", "a", " ", "single", " ", "CRN"}], 
    "*)"}], "\n", 
   RowBox[{"systematicCRN", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"multModule", ",", "sqrtModule"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.981410476954488*^9, 3.981410480506569*^9}, 
   3.9814245548900347`*^9, {3.981424742057742*^9, 3.981424755242261*^9}},
 CellLabel->
