Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Optimized", " ", 
    RowBox[{"CRN", ":", 
     RowBox[{"Removes", " ", "intermediate", " ", "Y"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"optimizedCRN", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rxn", "[", 
        RowBox[{
         RowBox[{"A", "+", "B"}], ",", 
         RowBox[{"A", "+", "B", "+", "Z"}], ",", "1"}], "]"}], ",", 
       RowBox[{"rxn", "[", 
        RowBox[{
         RowBox[{"2", " ", "Z"}], ",", "Z", ",", "1"}], "]"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Simulate", " ", "optimized", " ", "version"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solOpt", "=", 
     RowBox[{"SimulateRxnsys", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"optimizedCRN", ",", "inputs"}], "]"}], ",", "tmax"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "optimized", " ", "result"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"Z", "[", "t", "]"}], "/.", " ", "solOpt"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "500"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Red"}], "]"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "\"\<Final Output Z (Optimized)\>\"", "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time\>\"", ",", "\"\<Concentration\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Hand-Optimized Geometric Mean\>\""}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.9814105077039557`*^9, {3.98141108821421*^9, 3.981411102706862*^9}, {
   3.981424787993127*^9, 3.981424790147389*^9}, {3.981424830549715*^9, 
