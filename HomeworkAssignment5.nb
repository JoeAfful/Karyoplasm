    TemplateBox[{"\[ThinSpace]", "\" \"", "Y", 
      OverscriptBox["\[LongRightArrow]", "1"], "0"},
     "RowWithSeparators"],
    $CellContext`rxn[$CellContext`Y, 0, 1]], ",", 
