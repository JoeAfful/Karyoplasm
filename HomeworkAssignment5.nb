Cell[BoxData[
 RowBox[{"RosslerCRN", "=", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"dx", "/", "dt"}], " ", "reactions"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "first", " ", "reaction", " ", "represents", " ", "the", " ",
        "conversion", " ", "nof", " ", "Z", " ", "into", " ", "X"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "using", " ", "the", " ", "dual", " ", "rail", " ", "implementation",
           " ", "requires", " ", "splitting", " ", "Z", " ", "into", " ", 
          "Zp"}], "-", 
         RowBox[{"Zm", " ", "to", " ", "produce", " ", "Xp"}], "-", "Xm"}], 
        "..."}], "However", " ", "due", " ", "to", " ", "the", " ", 
       "negative", " ", "sign", " ", "infront", " ", "of", " ", "Z"}], ",", 
      " ", 
      RowBox[{
       RowBox[{
       "the", " ", "dual", " ", "rail", " ", "system", " ", "for", " ", "Z", " ",
         "is", " ", "effectively", " ", "Zm"}], "-", 
       RowBox[{
       "Zp", " ", "this", " ", "means", " ", "Zm", " ", "effectively", " ", 
        "produces", " ", "Xp", " ", "and", " ", "Zp", " ", "effectively", " ",
         "produces", " ", "Xm"}]}], ",", " ", 
      RowBox[{
      "this", " ", "is", " ", "the", " ", "same", " ", "logic", " ", "for", " ",
        "the", " ", "rxn", " ", "module", " ", "for", " ", "Y", " ", "as", " ",
        "well"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rxn", "[", 
      RowBox[{"Zp", ",", "Xm", ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{"Zm", ",", "Xp", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"rxn", "[", 
      RowBox[{"Yp", ",", "Xm", ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{"Ym", ",", "Xp", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"dy", "/", "dt"}], " ", "reactions"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "For", " ", "these", " ", "sets", " ", "of", " ", "reactions"}], ",", 
       " ", 
       RowBox[{
       "X", " ", "combines", " ", "with", " ", "Y", " ", "at", " ", "rate", " ",
         "1", " ", "to", " ", "form", " ", "2", " ", "molecules", " ", "of", " ",
         "Y", " ", "as", " ", "shown", " ", "in", " ", "the", " ", "ODE"}], ",",
        " ", 
       RowBox[{
       "and", " ", "Y", " ", "combines", " ", "with", " ", "X", " ", "at", " ",
         "rate", " ", "a", " ", "to", " ", "form", " ", "2", " ", "molecules",
         " ", "of", " ", "Y"}], ",", " ", 
       RowBox[{
       "these", " ", "are", " ", "represented", " ", "as", " ", "shown", " ", 
        "in", " ", "the", " ", "rxn", " ", "modules"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{"Xp", ",", 
       RowBox[{"Xp", "+", "Yp"}], ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{"Xm", ",", 
       RowBox[{"Xm", "+", "Ym"}], ",", "1"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{"Yp", ",", 
       RowBox[{"2", "Yp"}], ",", "a"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{"Ym", ",", 
       RowBox[{"2", "Ym"}], ",", "a"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"dz", "/", "dt"}], " ", "reactions"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", " ", "these", " ", "set", " ", "of", " ", "reactions"}],
        ",", " ", 
       RowBox[{
        RowBox[{
        "in", " ", "the", " ", "first", " ", "reaction", " ", "modeule", " ", 
         "we", " ", "have", " ", "the", " ", "initial", " ", "condition", " ",
          "at", " ", "t"}], "=", "0"}], ",", " ", 
       RowBox[{
        RowBox[{
        "where", " ", "there", " ", "is", " ", "a", " ", "fixed", " ", 
         "concentration", " ", "of", " ", "Zp"}], " ", "=", " ", "b"}], ",", 
       " ", 
       RowBox[{"in", " ", "the", " ", "second", " ", "module"}], ",", " ", 
       RowBox[{
       "combining", " ", "Z", " ", "and", " ", "X", " ", "produce"}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{"0", ",", "Zp", ",", "b"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Zp", "+", "Xp"}], ",", 
       RowBox[{
        RowBox[{"2", "Zp"}], "+", "Xp"}], ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Zm", "+", "Xm"}], ",", 
       RowBox[{"Zp", "+", "Xm", "+", "Zm"}], ",", "1"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Zp", "+", "Xm"}], ",", 
       RowBox[{"Zm", "+", "Xm", "+", "Zp"}], ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Zm", "+", "Xp"}], ",", 
       RowBox[{
        RowBox[{"2", "Zm"}], "+", "Xp"}], ",", "1"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{"Zp", ",", "Zm", ",", "c"}], "]"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"annihilation", " ", "reactions"}], ",", " ", 
       RowBox[{
       "as", " ", "shown", " ", "in", " ", "the", " ", "lecture", " ", 
        "notes", " ", "this", " ", "prevents", " ", "an", " ", "infinite", " ",
         "blowup", " ", "in", " ", "the", " ", "production", " ", 
        "species"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Xp", "+", "Xm"}], ",", "0", ",", "kfast"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Yp", "+", "Ym"}], ",", "0", ",", "kfast"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"Zp", "+", "Zm"}], ",", "0", ",", "kfast"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", "0.2"}], ",", 
     RowBox[{"b", "->", "0.2"}], ",", 
     RowBox[{"c", "->", "5.7"}], ",", 
     RowBox[{"kfast", "->", "100"}]}], "}"}]}]}]], "Input",
