Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "g", ",", "h", ",",
    "i", ",", "j", ",", "k", ",", "l", ",", "m", ",", "n", ",", "o", ",", "p",
    ",", "q", ",", "r", ",", "s", ",", "t", ",", "u", ",", "v", ",", "w", ",",
    "x", ",", "y", ",", "z"}], "}"}]], "Input",
 CellChangeTimes->{{3.946842031019072*^9, 3.946842045405579*^9}},
 CellLabel->
  "In[632]:=",ExpressionUUID->"7a4dad00-7fb3-461e-b56e-db6d5ec3851a"],

Cell[TextData[{
 "The code below for converting a CRN reaction system into the ODE form \
required by ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " is straightforward.   The heavy lifter is computing the stoichiometry \
coefficients from the algebraic expressions for the reactants and products.  \
Since these expressions must be algebraic representations of multisets, i.e. \
they are the sum of inert symbols with possible positive integer weights, we \
can recursively break it down, knowing that Mathematica will apply the \
first-listed matching pattern.   We define the set of species for a CRN \
implicitly as the union of species that appear in reactions and those that \
are assigned concentrations.  The ODEs themselves are produce as per the \
standard mass-action kinetics formula: first the flux rate for each reaction \
is computed (as an algebraic formula) and then the species rate of change is \
the sum over reactions of the stoichiometric difference. "
}], "Text",
 CellChangeTimes->{{3.693184611752716*^9, 3.693184650341352*^9}, {
   3.693184697661479*^9, 3.693185050035988*^9}, {3.693186190008719*^9, 
   3.6931861999823914`*^9}, {3.693246464847949*^9, 3.6932464665119343`*^9}, 
   3.9468415287004642`*^9, {3.946842270209306*^9, 3.9468422741620083`*^9}, {
   3.9468972353973207`*^9, 3.9468973324680443`*^9}, {3.9468975290145063`*^9, 
   3.946897603615382*^9}, {3.9468978469140987`*^9, 3.946897890771694*^9}, {
   3.946897932329361*^9, 3.946897997277707*^9}, {3.946898236412224*^9, 
   3.946898337637063*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"b26d8cd3-3544-432e-933c-eff514b7fc42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Stoichiometries", ",", "SpeciesInRxnsys", ",", "RxnsysToOdesys", ",", 
    "SimulateRxnsys"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Stoichiometries", "[", "0", "]"}], ":=", 
  RowBox[{"Association", "[", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Stoichiometries", "[", 
   RowBox[{"Plus", "[", 
    RowBox[{
     RowBox[{"Times", "[", 
      RowBox[{"s_Integer", ",", "a_"}], "]"}], ",", "b__"}], "]"}], "]"}], ":=", 
  RowBox[{"Merge", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{"a", "->", "s"}], "|>"}], ",", 
      RowBox[{"Stoichiometries", "[", 
       RowBox[{"Plus", "[", "b", "]"}], "]"}]}], "}"}], ",", "Total"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Stoichiometries", "[", 
   RowBox[{"Plus", "[", 
    RowBox[{"a_", ",", "b__"}], "]"}], "]"}], ":=", 
  RowBox[{"Merge", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{"a", "->", "1"}], "|>"}], ",", 
      RowBox[{"Stoichiometries", "[", 
       RowBox[{"Plus", "[", "b", "]"}], "]"}]}], "}"}], ",", "Total"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Stoichiometries", "[", 
   RowBox[{"Times", "[", 
    RowBox[{"s_Integer", ",", "a_"}], "]"}], "]"}], ":=", 
  RowBox[{"<|", 
   RowBox[{"a", "->", "s"}], "|>"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Stoichiometries", "[", "a_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{"a", "->", "1"}], "|>"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SpeciesInRxnsys", "[", "rxnsys_", "]"}], ":=", 
   RowBox[{"Union", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Union", "@@", 
      RowBox[{"Cases", "[", 
       RowBox[{"rxnsys", ",", 
        RowBox[{
         RowBox[{"conc", "[", 
          RowBox[{"sp_", ",", "c_"}], "]"}], ":>", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ListQ", "[", "sp", "]"}], ",", "sp", ",", 
           RowBox[{"{", "sp", "}"}]}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Union", "@@", 
      RowBox[{"Cases", "[", 
       RowBox[{"rxnsys", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rxn", "|", "revrxn"}], ")"}], "[", 
          RowBox[{"reactants_", ",", "products_", ",", "__"}], "]"}], ":>", 
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"Keys", "[", 
            RowBox[{"Stoichiometries", "[", "reactants", "]"}], "]"}], ",", 
           RowBox[{"Keys", "[", 
            RowBox[{"Stoichiometries", "[", "products", "]"}], "]"}]}], 
          "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RxnsysToOdesys", "[", "rxnsys_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rxns", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{"rxnsys", ",", "_rxn"}], "]"}], ",", 
           RowBox[{"Cases", "[", 
            RowBox[{"rxnsys", ",", 
             RowBox[{
              RowBox[{"revrxn", "[", 
               RowBox[{"r_", ",", "p_", ",", "kf_", ",", "kr_"}], "]"}], ":>", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"rxn", "[", 
                 RowBox[{"r", ",", "p", ",", "kf"}], "]"}], ",", 
                RowBox[{"rxn", "[", 
                 RowBox[{"p", ",", "r", ",", "kr"}], "]"}]}], "}"}]}]}], 
            "]"}]}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"concs", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{"rxnsys", ",", 
          RowBox[{"c_conc", ":>", 
           RowBox[{"Thread", "[", "c", "]"}]}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"species", "=", 
        RowBox[{"SpeciesInRxnsys", "[", "rxnsys", "]"}]}], ",", 
       "\[IndentingNewLine]", "r", ",", "p", ",", "F"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Stoichiometries", "[", 
          RowBox[{"rxns", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "rxns", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Stoichiometries", "[", 
          RowBox[{"rxns", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], ",", 
