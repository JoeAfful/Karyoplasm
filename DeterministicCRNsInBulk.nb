Cell[CellGroupData[{

Cell["\<\
Analog rate-independent stoichiometric circuits that consume inputs\
\>", "Section",
 CellChangeTimes->{{3.506895103099546*^9, 3.506895220085722*^9}, {
  3.6433217229489517`*^9, 3.643321727196405*^9}, {3.693028098666761*^9, 
  3.693028105577589*^9}, {3.756089597504829*^9, 3.756089622419126*^9}, {
  3.756095985523988*^9, 3.756095994128634*^9}, {3.7560961172106943`*^9, 
  3.756096120369234*^9}, {3.819421138219533*^9, 3.819421149599025*^9}, {
  3.851041690271902*^9, 3.851041696253357*^9}, {3.980612603483005*^9, 
  3.980612603890895*^9}},ExpressionUUID->"41a77e94-d0dd-4a9e-985b-\
209187713aaf"],

Cell[TextData[{
 "The notion of computation here is that a CRN computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    RowBox[{"f", "(", 
     RowBox[{"a", ",", "b"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "c63c0363-f5d2-4ba1-8cdd-ae5388912ffe"],
 " if when started with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"[", "A", "]"}], "0"], "=", "a"}], ",", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"[", "B", "]"}], "0"], "=", "b"}]}], TraditionalForm]],
  ExpressionUUID->"b71f3409-b803-48ac-aff1-ef1d62674629"],
 ", and everything else absent, the CRN will converge to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      RowBox[{"[", "X", "]"}], "\[Infinity]"], "=", "x"}], ",", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"[", "Y", "]"}], "\[Infinity]"], "=", "y"}]}], 
   TraditionalForm]],ExpressionUUID->"8e7ab7ec-64a8-486a-a185-1031ad05ea04"],
 ", and maybe some other stuff left over; further this fact must hold for any \
set of positive rate constants assigned to the reactions.  It is a very \
strong requirement for robustness, and the types of functions computable with \
this constraint are in fact provably limited.  To the extent that computation \
can be done, it involves consuming and converting species from one form to \
another (hence \[OpenCurlyDoubleQuote]stoichiometric\[CloseCurlyDoubleQuote] \
-- how much gets converted to how much) until there is no more to convert.  \
(See e.g. \[OpenCurlyDoubleQuote]Deterministic function computation with \
chemical reaction networks\[CloseCurlyDoubleQuote] by Ho-Lin Chen, David \
Doty, and David Soloveichik, Natural Computing, 2014.)   We aren\
\[CloseCurlyQuote]t covering this case this year.  Feel free to poke around \
if you are curious."
}], "Text",
 CellChangeTimes->{{3.693187450367138*^9, 3.693187585912004*^9}, {
  3.693187633577146*^9, 3.6931876563519993`*^9}, {3.756089405477928*^9, 
  3.756089409350511*^9}, {3.756089461860489*^9, 3.756089524409465*^9}, {
  3.756096020425213*^9, 3.756096036648485*^9}, {3.7560961588385897`*^9, 
  3.756096216156043*^9}, {3.756096267867468*^9, 3.756096382123472*^9}, {
  3.756096546412541*^9, 3.756096602356654*^9}, {3.7560978018230257`*^9, 
  3.756097863495556*^9}, {3.756098064743659*^9, 3.756098072561225*^9}, {
  3.819428610163763*^9, 3.81942863777951*^9}, {3.81942895787654*^9, 
  3.819429160333229*^9}, {3.819429203437113*^9, 3.81942936405095*^9}, {
  3.8194294336328773`*^9, 3.8194295043780003`*^9}, {3.819429639839501*^9, 
  3.819429645548294*^9}, {3.8194357145980577`*^9, 3.8194358112766542`*^9}, {
  3.851041688416356*^9, 3.851041701479212*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"cabab88c-211e-4b97-96ae-29ebfad6e23b"],

Cell[TextData[{
 "Performing a well-defined amplification: size up to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "k"], TraditionalForm]],ExpressionUUID->
  "37725c55-13a9-4975-94dd-fa7c2194e4b1"],
 "using O(k) reactions.  Here, k=6."
}], "Text",
 CellChangeTimes->{{3.693187450367138*^9, 3.693187585912004*^9}, {
  3.693187633577146*^9, 3.6931876563519993`*^9}, {3.756089405477928*^9, 
  3.756089409350511*^9}, {3.756089461860489*^9, 3.756089524409465*^9}, {
  3.756096020425213*^9, 3.756096036648485*^9}, {3.7560961588385897`*^9, 
  3.756096216156043*^9}, {3.756096267867468*^9, 3.756096382123472*^9}, {
  3.756096546412541*^9, 3.756096602356654*^9}, {3.7560978018230257`*^9, 
  3.756097863495556*^9}, {3.756098064743659*^9, 3.756098072561225*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"1cecc2f8-71cb-4c85-8661-db170be1a250"],

