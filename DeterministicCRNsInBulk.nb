Cell[TextData[{
 "With these modules we can easily compute other functions as well, such as \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", "=", 
    RowBox[{
     SuperscriptBox["X", "2"], "-", 
     SqrtBox["X"], "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "729c9684-25d5-4ecf-9139-b7f6efbac364"],
 ".  Which of the following two implementations is correct, and why?"
}], "Text",
 CellChangeTimes->{{3.6931876884200983`*^9, 3.6931877416027184`*^9}, {
   3.755920605445594*^9, 3.755920606252111*^9}, {3.7560917808156223`*^9, 
