Cell[BoxData[
 RowBox[{"rsys", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", 
      RowBox[{"X", "+", "Y"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"2", "X"}], ",", "P", ",", "1"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{"c", ",", "P", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"Y", "+", "B"}], ",", "Q", ",", "1"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{"P", ",", 
      RowBox[{"Z", "+", "R"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"rxn", "[", 
     RowBox[{"Q", ",", 
      RowBox[{"Z", "+", "S"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"R", "+", "S"}], ",", "T", ",", "1"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"T", "+", "Z"}], ",", "0", ",", "1"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"conc", "[", 
     RowBox[{"A", ",", "5"}], "]"}], ",", 
    RowBox[{"conc", "[", 
     RowBox[{"B", ",", "2"}], "]"}], ",", 
    RowBox[{"conc", "[", 
     RowBox[{"c", ",", "3"}], "]"}]}], "\[IndentingNewLine]", 
   "}"}]}]], "Input",
