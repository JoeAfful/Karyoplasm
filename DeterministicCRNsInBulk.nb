Cell[TextData[{
 "Let\[CloseCurlyQuote]s show how easy it is to look at the input/output \
function for a CRN.  It would be more natural to just define ",
 StyleBox["rsys",
  FontWeight->"Bold"],
 " to have variables for the initial concentrations, but here we\
\[CloseCurlyQuote]re lazy and we just use an awkward rewriting rule to modify \
",
 StyleBox["rsys",
  FontWeight->"Bold"],
 " to have the initial conditions we want -- which will be A between 0 and 5, \
B between 0 and 5, and C held constant at 1.  The accuracy is within 0.2 for \
this simulation time; presumably, an even longer simulation would get closer \
to the correct value."
}], "Text",
 CellChangeTimes->{{3.724721123369918*^9, 3.724721286268512*^9}, {
  3.724722338514045*^9, 3.724722342760301*^9}, {3.724722422689558*^9, 
  3.724722456112049*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"9b9096c4-d616-4ed0-95a8-67815e5d4d91"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"io", "=", 
   RowBox[{"Table", "[", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"build", " ", "a", " ", "2", "D", " ", "table"}], ",", " ", 
      RowBox[{
      "with", " ", "each", " ", "entry", " ", "being", " ", "the", " ", 
       "pair", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"simulation", " ", "output"}], ",", " ", 
         RowBox[{"target", " ", "function", " ", "value"}]}], ")"}]}]}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"SimulateRxnsys", "[", 
        RowBox[{
         RowBox[{"rsys", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"conc", "[", 
              RowBox[{"A", ",", "5"}], "]"}], "\[Rule]", 
             RowBox[{"conc", "[", 
              RowBox[{"A", ",", "A0"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"conc", "[", 
              RowBox[{"B", ",", "2"}], "]"}], "\[Rule]", 
             RowBox[{"conc", "[", 
              RowBox[{"B", ",", "B0"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"conc", "[", 
              RowBox[{"c", ",", "3"}], "]"}], "\[Rule]", 
             RowBox[{"conc", "[", 
              RowBox[{"c", ",", "1"}], "]"}]}]}], "}"}]}], ",", 
         RowBox[{"10", "*", "tmax"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Z", "[", "tmax", "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{"A", "[", "0", "]"}], ",", 
             RowBox[{"B", "[", "0", "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", "0", "]"}], "/", "2"}], "+", 
            RowBox[{"c", "[", "0", "]"}]}]}], "]"}]}], "}"}], "/.", "sol"}]}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"A0", ",", "0", ",", "5", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"B0", ",", "0", ",", "5", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"simio", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"First", ",", "io", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"targetio", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"Last", ",", "io", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]}], "Input",
