Cell[CellGroupData[{

Cell["\<\
Considerations about reversible reactions and units of time and concentration\
\
\>", "Subsection",
 CellChangeTimes->{{3.506895103099546*^9, 3.506895220085722*^9}, {
  3.6433217229489517`*^9, 3.643321727196405*^9}, {3.819421265069579*^9, 
  3.8194212782655563`*^9}},ExpressionUUID->"aa4d56bb-e2fe-4c79-bf57-\
d3647ec5aa30"],

Cell[TextData[{
 "It is important to understand that the user is responsible for keeping \
track of units.  In the example below, the forward rate constants for \
bimolecular reactions are 1.5*",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "6"], TraditionalForm]],ExpressionUUID->
  "53f6e05f-bed6-48f9-a78d-b82fa4a5bbba"],
 " /M/s, while the reverse reaction is 10 /s.  The unimolecular reactions are \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SuperscriptBox["x10", 
     RowBox[{"-", "4"}]]}], TraditionalForm]],ExpressionUUID->
  "51c1bddb-289e-46ed-b79c-011b3cc9be0a"],
 " /s.  The initial concentrations are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]],ExpressionUUID->
  "e645705f-4735-4e67-9471-2caee6b5fe04"],
 " M, i.e. 10 nM.  Time is expressed in seconds, so the simulation follows 2 \
hours of dynamics.\n\nWe also introduce here the ",
 StyleBox["revrxn[ ] ",
  FontWeight->"Bold"],
 "statement, which is merely a shorthand for both the forward reaction and \
the reverse reaction simultaneously.  Because you might want to think of such \
reactions as inherently paired, the simulator leaves them as you wrote \
them... but for simulations they are identical to have two separate \
reactions.  ",
 StyleBox["ExpandRevrxns[ ]",
  FontWeight->"Bold"],
 " explicitly puts them in that form if you prefer it."
}], "Text",
 CellChangeTimes->{{3.69318676521277*^9, 3.693186860362377*^9}, {
  3.6931868969382973`*^9, 3.693186953754304*^9}, {3.7560976465717497`*^9, 
  3.756097685647244*^9}, {3.8194215799771423`*^9, 3.819421796507156*^9}, {
  3.8510414744896297`*^9, 3.851041585184359*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"63aa1be9-1a4b-413c-a03d-84bd637e4e03"],

Cell[BoxData[
 RowBox[{"rsys", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"revrxn", "[", 
     RowBox[{
      RowBox[{"a", "+", "b"}], ",", 
      RowBox[{"b", "+", "b"}], ",", 
      RowBox[{"1.5", " ", 
       RowBox[{"10", "^", "6"}]}], ",", "10"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"revrxn", "[", 
     RowBox[{
      RowBox[{"b", "+", "c"}], ",", 
      RowBox[{"c", "+", "c"}], ",", 
      RowBox[{"1.5", " ", 
       RowBox[{"10", "^", "6"}]}], ",", "10"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"revrxn", "[", 
