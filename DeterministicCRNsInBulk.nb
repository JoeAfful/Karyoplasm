    RowBox[{"rxn", "[", 
     RowBox[{"d", ",", 
      RowBox[{"2", "e"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"e", ",", 
      RowBox[{"2", "f"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"f", ",", 
      RowBox[{"2", "g"}], ",", "1"}], "]"}]}], "}"}]}]], "Input",
