 RowBox[{"rsys", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"a", ",", 
      RowBox[{"2", "b"}], ",", "1"}], "]"}], ",", " ", 
    RowBox[{"rxn", "[", 
     RowBox[{"b", ",", 
      RowBox[{"2", "c"}], ",", "1"}], "]"}], ",", " ", 
    RowBox[{"rxn", "[", 
