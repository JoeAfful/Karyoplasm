Cell[TextData[{
 "Here we show the CRN implementation of a function that may have been \
discussed in the lecture:  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "\[Infinity]"], TraditionalForm]],ExpressionUUID->
  "8d9c63ca-65f8-4dcb-a368-70a482669257"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"max", "(", 
    RowBox[{"min", "(", 
     RowBox[{
      SubscriptBox["A", "0"], ",", 
      SubscriptBox["B", "0"]}]}]}], TraditionalForm]],ExpressionUUID->
  "0027a903-fe9a-497d-a101-5b9c6b6ef96c"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox["A", "0"]}], TraditionalForm]],ExpressionUUID->
  "ba916f6d-e691-4459-8472-19fa4c0ec7f4"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "0"], TraditionalForm]],ExpressionUUID->
  "6147d0fb-23c3-45f3-b4ac-8f418e1f2c6e"],
 ").\n\nThis simulation time is such that the CRN hasn\[CloseCurlyQuote]t \
quite gone to completion yet, but is close."
}], "Text",
