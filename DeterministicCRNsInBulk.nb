Cell[BoxData[
 RowBox[{
  RowBox[{"sols", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"R", "'"}], "[", "t", "]"}], "\[Equal]", " ", 
          RowBox[{
           RowBox[{"R", "[", "t", "]"}], "-", 
           RowBox[{"1.5", "*", 
            RowBox[{"R", "[", "t", "]"}], "*", 
            RowBox[{"F", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"F", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{"1.5", "*", 
            RowBox[{"R", "[", "t", "]"}], "*", 
            RowBox[{"F", "[", "t", "]"}]}], "-", 
           RowBox[{"F", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"R", "[", "0", "]"}], "\[Equal]", "Rinit"}], ",", 
         RowBox[{
          RowBox[{"F", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"R", ",", "F"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Rinit", ",", "0", ",", "3", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
