Cell[TextData[{
 "An important feature of the CRNSimulator package is that it is possible to \
define CRN \[OpenCurlyDoubleQuote]subroutines\[CloseCurlyDoubleQuote] or \
\[OpenCurlyDoubleQuote]modules\[CloseCurlyDoubleQuote], and systematically \
build larger CRNs based on those generic components.  Note that the H in \
CRNsub and the T in CRNam are instantiated as new unique variables (e.g. \
H$655 and T$78324) every time the module is used -- this way you can build a \
CRN that uses multiple \[OpenCurlyDoubleQuote]subtraction\
\[CloseCurlyDoubleQuote] (rsub) or \[OpenCurlyDoubleQuote]approximate \
majority\[CloseCurlyDoubleQuote] (am) modules with having their intermediate \
species interfere with each other.  Note that because the approximate \
majority (am) module changes the values of its inputs, it does not conform to \
the input/output convention discussed in class.  (Also, variable names don\
\[CloseCurlyQuote]t always agree with class notes.)\n\nHere we demonstrate \
some of the modules from Vasic, Soloveichik, and Khurshid (2018), and apply \
them to compute the hypotenuse of a triangle according to the Pythagorean \
theorem, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", " ", "="}], TraditionalForm]],ExpressionUUID->
  "cda6b83f-ab8a-46e1-a0e3-3b99df82a392"],
 " ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{
     SuperscriptBox["A", "2"], "+", 
     SuperscriptBox["B", "2"]}]], TraditionalForm]],ExpressionUUID->
  "e35d0545-c527-4aa5-a8ab-83e1dfb6767c"],
 "."
}], "Text",
 CellChangeTimes->{{3.6931876884200983`*^9, 3.6931877416027184`*^9}, {
   3.755920605445594*^9, 3.755920606252111*^9}, {3.7560917808156223`*^9, 
   3.756091851937894*^9}, {3.7567599328393087`*^9, 3.7567601237857437`*^9}, 
   3.756760184412734*^9, {3.819637575186627*^9, 3.8196376195216303`*^9}, {
   3.819654828401967*^9, 3.819654843619851*^9}, {3.851129515933515*^9, 
   3.851129521084046*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"bc565f9f-259b-4ca4-8bef-547ea6b3ec05"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CRNconst", "[", 
   RowBox[{"A_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"0", ",", "A", ",", "v"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNcopy", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", 
      RowBox[{"A", "+", "B"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"B", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNadd", "[", 
   RowBox[{"A_", ",", "B_", ",", "C_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", 
      RowBox[{"A", "+", "C"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"B", ",", 
      RowBox[{"B", "+", "C"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"C", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNsquare", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"2", "A"}], ",", 
      RowBox[{
       RowBox[{"2", "A"}], "+", "B"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"B", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNsqrt", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", 
      RowBox[{"A", "+", "B"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"B", "+", "B"}], ",", "0", ",", 
      RowBox[{"1", "/", "2"}]}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNmul", "[", 
   RowBox[{"A_", ",", "B_", ",", "C_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"A", "+", "B"}], ",", 
      RowBox[{"A", "+", "B", "+", "C"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{"C", ",", "0", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNdiv", "[", 
   RowBox[{"A_", ",", "B_", ",", "C_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rxn", "[", 
     RowBox[{"A", ",", 
      RowBox[{"A", "+", "C"}], ",", "1"}], "]"}], ",", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"B", "+", "C"}], ",", "B", ",", "1"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNrsub", "[", 
   RowBox[{"A_", ",", "B_", ",", "C_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "H", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rxn", "[", 
       RowBox[{"A", ",", 
        RowBox[{"A", "+", "C"}], ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{"B", ",", 
        RowBox[{"B", "+", "H"}], ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{"C", ",", "0", ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"C", "+", "H"}], ",", "0", ",", "1"}], "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CRNfexp", "[", 
    RowBox[{"A_", ",", "B_", ",", "n_Integer", ",", "d_Integer"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"n", " ", "A"}], ",", 
       RowBox[{
        RowBox[{"n", " ", "A"}], " ", "+", " ", "B"}], ",", "1"}], "]"}], ",", 
     RowBox[{"rxn", "[", 
      RowBox[{
       RowBox[{"d", " ", "B"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}], " ", "B"}], ",", "1"}], "]"}]}], 
    "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "\"\<approximate majority\>\"", " ", "module"}], ",", 
    " ", 
    RowBox[{
     RowBox[{
     "which", " ", "is", " ", "not", " ", "a", " ", "catalytic", " ", 
      "steady"}], "-", 
     RowBox[{"state", " ", "analog", " ", "computation", " ", "module"}]}]}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CRNam", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "T", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"A", "+", "B"}], ",", 
        RowBox[{"A", "+", "T"}], ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"B", "+", "A"}], ",", 
        RowBox[{"B", "+", "T"}], ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"T", "+", "A"}], ",", 
        RowBox[{"A", "+", "A"}], ",", "1"}], "]"}], ",", 
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"T", "+", "B"}], ",", 
        RowBox[{"B", "+", "B"}], ",", "1"}], "]"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.756089685768961*^9, 3.756090102611351*^9}, {
