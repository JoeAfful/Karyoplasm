Cell[TextData[{
 "How do we compute COPY, i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "\[Infinity]"], "=", " ", 
    RowBox[{
     SubscriptBox["C", "\[Infinity]"], "=", 
     RowBox[{
      SubscriptBox["A", "0"], " ", "?", " "}]}]}], TraditionalForm]],
  ExpressionUUID->"6a3f6972-02b4-48f3-bd50-bdb6eafedd96"],
 "\n\nNote that the species C is represented by \[OpenCurlyDoubleQuote]c\
\[CloseCurlyDoubleQuote] because Mathematica has a built-in meaning for \
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote]. If you want to use \
uppercase \[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote], note that C\\[N u \
l l] is a different symbol, if typed without the spaces."
}], "Text",
 CellChangeTimes->{{3.693187450367138*^9, 3.693187585912004*^9}, {
  3.693187633577146*^9, 3.6931876563519993`*^9}, {3.756089405477928*^9, 
