Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", "=", "15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"SimulateRxnsys", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"rsys", ",", 
       RowBox[{"{", 
        RowBox[{"conc", "[", 
         RowBox[{"a", ",", "1"}], "]"}], "}"}]}], "]"}], ",", "tmax"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], ",", 
