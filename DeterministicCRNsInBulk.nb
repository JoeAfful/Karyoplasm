Cell["\<\
You can set up the same predator-prey ODEs by hand if you like; this is what \
SimulateRxnsys is doing under the hood automatically.\
\>", "Text",
 CellChangeTimes->{{3.694305306025725*^9, 3.694305364775466*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"8aba5020-45e6-4d33-9046-e03b133563dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", "=", "45"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"R", "'"}], "[", "t", "]"}], "\[Equal]", " ", 
       RowBox[{
        RowBox[{"R", "[", "t", "]"}], "-", 
        RowBox[{"1.5", "*", 
         RowBox[{"R", "[", "t", "]"}], "*", 
         RowBox[{"F", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"F", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"1.5", "*", 
         RowBox[{"R", "[", "t", "]"}], "*", 
         RowBox[{"F", "[", "t", "]"}]}], "-", 
        RowBox[{"F", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"R", "[", "0", "]"}], "\[Equal]", "2"}], ",", 
      RowBox[{
       RowBox[{"F", "[", "0", "]"}], "\[Equal]", "1"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"R", ",", "F"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.694305372615814*^9, 3.6943055518110723`*^9}, {
  3.6943056001067038`*^9, 3.694305607297295*^9}, {3.819418779210137*^9, 
